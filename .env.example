# copiar a .env y cambiar los valores (el .env no se sube al repo)
DEMO_PASSWORD=cambiar-esta-clave
OPS_CLIENT_SECRET=cambiar-secreto-ops
PAGOS_CLIENT_SECRET=cambiar-secreto-pagos
CONFIG_PASSWORD=cambiar-clave-config
MYSQL_ROOT_PASSWORD=cambiar-root
DB_PASSWORD=cambiar-clave-bd
GATEWAY_KEYSTORE_PASSWORD=changeit

# kafka local (kafka + kafka-ui en el compose). para usar el kafka de la ec2 (infra/ansible):
# borrar esta linea (o dejarla vacia) y descomentar KAFKA_BOOTSTRAP con la ip que imprime deploy.yml
COMPOSE_PROFILES=kafka-local
# KAFKA_BOOTSTRAP=x.x.x.x:9094
