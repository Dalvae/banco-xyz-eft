<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>cl.duoc.bank</groupId><artifactId>bank-s9</artifactId><version>1.0.0</version><packaging>pom</packaging>
  <name>Banco XYZ EFT - spring cloud, microservicios y batch</name>
  <properties>
    <java.version>21</java.version>
    <!-- 2.2.0 y no 2.3.0: el bom de spring cloud deja los otros jar de resilience4j en 2.2.0 y si se mezclan no parte -->
    <resilience4j.version>2.2.0</resilience4j.version>
    <!-- 2025.0.x (northfields) es la que va con boot 3.5 -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
  </properties>
  <modules>
    <module>shared</module>
    <module>config-server</module>
    <module>eureka-server</module>
    <module>api-gateway</module>
    <module>auth-server</module>
    <module>ms-cuentas</module>
    <module>ms-pagos</module>
    <module>ms-clientes</module>
    <module>bff-web</module>
    <module>bff-mobile</module>
    <module>bff-atm</module>
    <module>notificaciones</module>
    <module>batch</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency><groupId>io.github.resilience4j</groupId><artifactId>resilience4j-spring-boot3</artifactId><version>${resilience4j.version}</version></dependency>
      <dependency><groupId>org.springframework.cloud</groupId><artifactId>spring-cloud-dependencies</artifactId><version>${spring-cloud.version}</version><type>pom</type><scope>import</scope></dependency>
    </dependencies>
  </dependencyManagement>
</project>
